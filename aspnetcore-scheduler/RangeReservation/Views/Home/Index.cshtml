@{
    ViewData["Title"] = "Book a range";
    var user = (AppUser)ViewBag.User;
    var isAdmin = user.Role == Roles.Admin;
    var now = (DateTime)ViewBag.Now;

    // Two-level resource grouping: Facility -> Range (shooting range / bay)
    var facilities = ((List<Facility>)ViewBag.Facilities)
        .Select(f => new { id = f.Id, text = f.Name, color = f.Color }).ToList();
    var ranges = ((List<ShootingRange>)ViewBag.Ranges)
        .Select(r => new { id = r.Id, text = r.Name, groupId = r.FacilityId, color = r.Color }).ToList();
}

<div class="layout">
    <aside class="side">
        <section class="card" id="policyCard" aria-live="polite"></section>

        <section class="card cart" id="cartCard">
            <div class="card-head">
                <h3>Multi-date booking</h3>
                <input id="cartMode" type="checkbox" />
            </div>
            <p class="muted small">Turn on, then click slots on <strong>one range</strong> across as many dates as you need.
                All dates are submitted together as one request for admin review.</p>
            <div id="cartRange" class="cart-range muted small">Range: <em>first slot you pick</em></div>
            <ul id="cartList" class="cart-list"><li class="empty">No dates selected</li></ul>
            <div class="cart-fields">
                <input id="cartSubject" />
                @if (isAdmin)
                {
                    <input id="cartGroup" />
                }
                <div class="two">
                    <input id="cartHeadcount" />
                    <input id="cartTargetCount" />
                </div>
                <input id="cartFirearms" />
                <div class="two">
                    <input id="cartTargetType" />
                    <input id="cartTargetDistance" />
                </div>
                <input id="cartRso" type="checkbox" />
                <div class="two">
                    <input id="cartDayStart" />
                    <input id="cartDuration" />
                </div>
                <p class="muted tiny">Start time / hours are used for whole-day cells clicked in Month view.</p>
            </div>
            <div class="cart-actions">
                <button id="cartCheck" class="e-btn e-outline">Check availability</button>
                <button id="cartBook" class="e-btn e-primary">@(isAdmin ? "Book all" : "Submit for review")</button>
                <button id="cartClear" class="e-btn e-flat">Clear</button>
            </div>
            <div id="cartResult" class="result"></div>
        </section>

        <section class="card legend">
            <h3>Legend</h3>
            <ul>
                <li><span class="sw sw-approved"></span>Approved@(isAdmin ? "" : " (my group)")</li>
                <li><span class="sw sw-review"></span>Pending admin review</li>
                <li><span class="sw sw-masked"></span>Reserved by another organization</li>
                <li><span class="sw sw-block"></span>Blackout (hard block)</li>
                <li><span class="sw sw-pending"></span>Selected in cart (not submitted)</li>
                @if (!isAdmin) { <li><span class="sw sw-disabled"></span>Not bookable for your group (Monday LE rule, booking window)</li> }
            </ul>
        </section>
    </aside>

    <section class="main-panel">
        <div class="toolbar-row">
            <div class="filter"><input id="facilityFilter" /></div>
            @if (isAdmin)
            {
                <input id="adminOverride" type="checkbox" />
            }
            <span class="spacer"></span>
            <span class="muted small">Facility time: <strong>@now.ToString("ddd MMM d, h:mm tt")</strong> (Arizona, MST)</span>
            <button id="refreshBtn" class="e-btn e-small">Refresh</button>
        </div>

        @* ===================== Syncfusion ASP.NET Core Scheduler =====================
           allowOverlap is on because UC-10 allows a group to double-book itself; overlaps with OTHER
           organizations are hard-blocked by the server (and shown as "Reserved" blocks to everyone else). *@
        <ejs-schedule id="schedule" width="100%" height="780px"
                      selectedDate="@now.Date" currentView="TimelineDay"
                      startHour="06:00" endHour="21:00"
                      allowDragAndDrop="@isAdmin" allowResizing="@isAdmin"
                      allowOverlap="true" showTimeIndicator="false"
                      showQuickInfo="true"
                      created="onScheduleCreated"
                      actionBegin="onActionBegin"
                      actionComplete="onActionComplete"
                      actionFailure="onActionFailure"
                      popupOpen="onPopupOpen"
                      popupClose="onPopupClose"
                      cellClick="onCellClick"
                      cellDoubleClick="onCellDoubleClick"
                      select="onSelect"
                      renderCell="onRenderCell"
                      eventRendered="onEventRendered"
                      dragStart="onDragStart"
                      resizeStart="onResizeStart">
            <e-schedule-group byGroupID="true" resources="@(new[] { "Facilities", "Ranges" })"></e-schedule-group>
            <e-schedule-resources>
                <e-schedule-resource dataSource="@facilities" field="FacilityId" title="Facility" name="Facilities"
                                     textField="text" idField="id" colorField="color"></e-schedule-resource>
                <e-schedule-resource dataSource="@ranges" field="RangeId" title="Range" name="Ranges"
                                     textField="text" idField="id" groupIDField="groupId" colorField="color"></e-schedule-resource>
            </e-schedule-resources>
            <e-schedule-timescale enable="true" interval="60" slotCount="1"></e-schedule-timescale>
            <e-schedule-workhours highlight="true" start="07:00" end="19:00"></e-schedule-workhours>
            <e-schedule-eventsettings dataSource="@(new List<object>())" enableTooltip="true"></e-schedule-eventsettings>
            <e-schedule-views>
                <e-schedule-view option="TimelineDay"></e-schedule-view>
                <e-schedule-view option="TimelineWeek"></e-schedule-view>
                <e-schedule-view option="Day"></e-schedule-view>
                <e-schedule-view option="Week"></e-schedule-view>
                <e-schedule-view option="Month"></e-schedule-view>
                <e-schedule-view option="Agenda"></e-schedule-view>
            </e-schedule-views>
        </ejs-schedule>
    </section>
</div>

@section Scripts {
    <script>window.appContext = @Html.Raw(Json.Serialize(ViewBag.Context));</script>
    <script src="~/js/scheduler.js" asp-append-version="true"></script>
}
